# TEMPEST_EBS_RELAY_TOKEN=<at-least-32-random-characters>
# TEMPEST_EBS_CHANNEL_IDS=<numeric-twitch-channel-id>
# TEMPEST_EBS_ALLOWED_ACTIONS=tempest.blackhole
# TEMPEST_EBS_TLS_PFX=C:\path\to\localhost.pfx
# TEMPEST_EBS_TLS_PASSWORD=tempest-local-dev
