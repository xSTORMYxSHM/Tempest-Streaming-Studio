TWITCH_EXTENSION_SECRETS=<base64-extension-secret>
# Separate Twitch Extension used only for Bits-enabled surfaces. Keep these
# credentials distinct from the primary Tempest Streaming Extension above.
TEMPEST_BITS_EXTENSION_CLIENT_ID=<bits-extension-client-id>
TEMPEST_BITS_EXTENSION_SECRETS=<base64-bits-extension-secret>
# JSON object: immutable Twitch SKU -> published Studio interaction + exact Bits amount.
TEMPEST_BITS_PRODUCT_ACTIONS={"tempest.storm-pulse.50":{"action":"tempest.storm-pulse","bits":50}}
DATABASE_URL=<postgresql-connection-url>
TEMPEST_EBS_TWITCH_CLIENT_IDS=n04l25zbygbsnq6nj7gupboyeji820
# Discord Guests one-click sign-in (server-side secret; never put this in Studio):
# TEMPEST_DISCORD_CLIENT_ID=<discord-application-id>
# TEMPEST_DISCORD_CLIENT_SECRET=<discord-application-secret>
# TEMPEST_DISCORD_REDIRECT_URI=https://signal.tempestmainframe.com/discord/callback
# TEMPEST_EBS_ALLOWED_ORIGINS=https://localhost:8080
# TEMPEST_EBS_ALLOW_ANONYMOUS=0
# Legacy single-channel local mode only:
# TEMPEST_EBS_RELAY_TOKEN=<at-least-32-random-characters>
# TEMPEST_EBS_CHANNEL_IDS=<numeric-twitch-channel-id>
# TEMPEST_EBS_ALLOWED_ACTIONS=tempest.blackhole
# TEMPEST_EBS_TLS_PFX=C:\path\to\localhost.pfx
# TEMPEST_EBS_TLS_PASSWORD=tempest-local-dev
PORT=8080
