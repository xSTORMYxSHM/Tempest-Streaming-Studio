# Discord Guests one-click sign-in (server-side secret; never put this in Studio):
# TEMPEST_DISCORD_CLIENT_ID=<discord-application-id>
# TEMPEST_DISCORD_CLIENT_SECRET=<discord-application-secret>
# TEMPEST_DISCORD_REDIRECT_URI=https://signal.tempestmainframe.com/discord/callback
# TEMPEST_EBS_ALLOWED_ORIGINS=https://localhost:8080
# TEMPEST_EBS_ALLOW_ANONYMOUS=0
