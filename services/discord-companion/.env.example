# Created in the Discord Developer Portal. Never put the bot token in Studio.
TEMPEST_DISCORD_BOT_TOKEN=<discord-bot-token>
TEMPEST_DISCORD_APPLICATION_ID=<discord-application-id>

# Tempest Signal worker socket and a dedicated random service credential.
TEMPEST_SIGNAL_DISCORD_WORKER_URL=wss://signal.tempestmainframe.com/v1/discord/bot-worker
TEMPEST_SIGNAL_DISCORD_WORKER_TOKEN=<at-least-32-random-characters>

# Optional: register commands immediately in one test server. Omit in production
# to use globally registered commands (which can take time to propagate).
# TEMPEST_DISCORD_DEVELOPMENT_GUILD_ID=<discord-server-id>

# Speaking detection requires encrypted voice packet delivery. The bot remains
# self-muted and never subscribes to, decrypts, decodes, records, or stores audio.
TEMPEST_DISCORD_SELF_DEAF=0
TEMPEST_DISCORD_SIGNAL_GRACE_MS=30000
TEMPEST_DISCORD_RECONNECT_MS=5000

# Storm Horizon Radio. RADIO_URL remains accepted for migration from the old bot.
TEMPEST_RADIO_URL=<https-radio-stream-url>
TEMPEST_RADIO_VOLUME=45

# PebbleHost allocates the port. This server exposes only /healthz and /readyz.
PORT=8080
