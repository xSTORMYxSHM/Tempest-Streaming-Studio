{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempestmainframe.local/schemas/tempest.workflow.schema.json",
  "title": "Tempest Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "enabled", "trigger", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "enabled": { "type": "boolean" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action"],
      "properties": {
        "type": {
          "enum": ["viewer.interaction", "twitch.chat", "twitch.channel-points", "twitch.cheer", "system.event", "operator.manual"]
        },
        "action": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" }
      }
    },
    "cooldowns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewerMs": { "$ref": "#/$defs/duration" },
        "effectMs": { "$ref": "#/$defs/duration" },
        "globalMs": { "$ref": "#/$defs/duration" }
      }
    },
    "concurrencyGroup": { "type": "string", "maxLength": 80 },
    "maximumConcurrent": { "type": "integer", "minimum": 1, "maximum": 20 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "target", "capability"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "target": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
          "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
          "releaseCapability": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
          "arguments": { "type": "object" },
          "forwardInteractionPayload": { "type": "boolean" },
          "delayMs": { "$ref": "#/$defs/duration" },
          "lease": {
            "type": "object",
            "additionalProperties": false,
            "required": ["durationMs"],
            "properties": {
              "durationMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
              "durationInput": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
              "fadeInMs": { "$ref": "#/$defs/duration" },
              "fadeOutMs": { "$ref": "#/$defs/duration" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "duration": { "type": "integer", "minimum": 0, "maximum": 86400000 }
  }
}
